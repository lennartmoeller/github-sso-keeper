{
  "manifest_version": 3,
  "name": "GitHub SSO Keeper",
  "version": "0.2.0",
  "description": "A browser extension that keeps your GitHub Enterprise Cloud SSO session alive, built for Microsoft Entra ID OIDC single sign-on.",
  "homepage_url": "https://github.com/lennartmoeller/github-sso-keeper",
  "minimum_chrome_version": "148",
  "browser_specific_settings": {
    "gecko": {
      "id": "github-sso-keeper@lennartmoeller.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://github.com/*",
    "https://login.microsoftonline.com/*/oauth2/v2.0/authorize*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["github.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://login.microsoftonline.com/*/oauth2/v2.0/authorize*"],
      "js": ["entra.js"],
      "run_at": "document_start"
    }
  ]
}
