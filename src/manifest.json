{
  "manifest_version": 3,
  "name": "GitHub SSO Keeper",
  "version": "0.1.0",
  "description": "Keeps your GitHub Enterprise SSO session alive: renews it in the background and auto-clicks SSO prompts.",
  "homepage_url": "https://github.com/lennartmoeller/github-sso-keeper",
  "browser_specific_settings": {
    "gecko": {
      "id": "github-sso-keeper@lennartmoeller.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icon.svg"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://github.com/*",
    "https://login.microsoftonline.com/*/oauth2/v2.0/authorize*"
  ],
  "action": {
    "default_title": "GitHub SSO Keeper",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["github.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://login.microsoftonline.com/*/oauth2/v2.0/authorize*"],
      "js": ["entra.js"],
      "run_at": "document_start"
    }
  ]
}
